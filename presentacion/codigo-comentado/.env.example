# ============================================================================
#  .env.example  ->  MODELO DE CONFIGURACIÓN
# ============================================================================
#  El archivo .env real tiene datos privados (usuario y contraseña de la base)
#  y NO se sube a GitHub (está en .gitignore). Se sube solo este modelo.
#  bootstrap.php lo lee con la librería vlucas/phpdotenv y llena $_ENV.
# ============================================================================
# Copiá este archivo como .env y completá tus datos

# true = muestra el detalle de los errores (solo para desarrollo).
APP_DEBUG=true

# Datos de conexión a MySQL/MariaDB (los usa src/persistence/Database.php).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trafficop
DB_USER=root
DB_PASS=

# Ejecutable de Python (en Linux suele ser python3)
# Lo usa ScannerService.php para correr scanner/escanear.py.
PYTHON_BIN=python
